# ============================================
# CampusVision AI — Production Environment Variables
# ============================================
# Copy this file to .env on the remote server and fill in actual secrets.
# NEVER commit this file with real credentials to version control.
#
# Usage:
#   1. scp scripts/deploy/.env.production user@server:/opt/campusvision/.env
#   2. Edit /opt/campusvision/.env with real values
#   3. docker compose up -d
# ============================================

# --- Database ---
# MariaDB root password (used by docker-compose)
MARIADB_ROOT_PASSWORD=change_me_in_production

# MariaDB application user password (used by docker-compose)
MARIADB_PASSWORD=change_me_in_production

# --- JWT ---
# JWT signing secret for dormitory-service-go (32+ chars recommended)
# Must match main backend's signing key in production.
JWT_SECRET=change_me_in_production

# --- Camera Encryption ---
# AES-256-GCM encryption key (exactly 32 bytes)
# Used by: stream-gateway + dormitory-service-go for RTSP password encryption
# IMPORTANT: Must be the SAME value in both services.
CAMERA_ENCRYPTION_KEY=change_me_in_production

# --- Management API ---
# Management API key for stream-gateway (port 8081)
# Sent via X-Management-Key header.
MANAGEMENT_KEY=change_me_in_production

# --- Face Recognition ---
# Face recognition auth token for matcher API calls
# Sent as Bearer token to dormitory-service-go /api/face/match
FACE_AUTH_TOKEN=change_me_in_production

# --- CORS ---
# CORS allowed origins (comma-separated)
# Update DOMAIN below, then set this accordingly
CORS_ALLOWED_ORIGINS=http://192.168.x.100,http://192.168.x.100:8083

# --- Domain / Server ---
# Server IP or domain (used for documentation and CORS)
DOMAIN=192.168.x.100

# --- Kafka ---
# Kafka broker addresses (comma-separated)
# Default works for single-node Docker Compose deployment
KAFKA_BROKERS=kafka:9092

# --- MinIO (optional, currently unused) ---
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=change_me_in_production
